# Database
POSTGRES_USER=knowly
POSTGRES_PASSWORD=knowly
POSTGRES_DB=knowly
DATABASE_URL=postgresql+asyncpg://knowly:knowly@db:5432/knowly

# Application
SECRET_KEY=change-me-in-production
SESSION_LIFETIME_DAYS=14
FRONTEND_ORIGIN=https://localhost:8443
EDIT_NOTIFICATION_GRACE_SECONDS=300
FRIEND_REREQUEST_COOLDOWN_HOURS=0

# OAuth (Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://localhost:8443/api/auth/google/callback

# LLM + moderation
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_RATE_LIMIT_PER_HOUR=30
MODERATION_ENABLED=true
MODERATION_THRESHOLD=0.5
MODERATION_THRESHOLD_OVERRIDES=

# Admin bootstrap 
INITIAL_ADMIN_EMAIL=

# Storage
UPLOAD_MAX_BYTES=5242880
AVATAR_MAX_BYTES=2097152
